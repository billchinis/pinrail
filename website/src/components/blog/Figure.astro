---
// A numbered figure in a post: whatever it holds, and a caption under it
// that starts with its number. `wide` lets it run wider than the text.
interface Props { n: number; caption: string; wide?: boolean }
const { n, caption, wide = false } = Astro.props;
// a `caption` slot, such as one with a link, in place of the plain caption,
// when it holds anything
const slotted = Astro.slots.has("caption") ? (await Astro.slots.render("caption")).trim() : "";
---
<figure class:list={["post-figure", { wide }]}>
  <slot />
  <figcaption><b>FIG {n}</b>{slotted ? <Fragment set:html={slotted} /> : caption}</figcaption>
</figure>
