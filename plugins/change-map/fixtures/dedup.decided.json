        "path": "web/src/TicketForm.tsx",
        "status": "modified",
        "diff": "@@ -38,20 +38,31 @@ export function TicketForm({ onSaved }: Props) {\n   const [title, setTitle] = useState(\"\");\n   const [body, setBody] = useState(\"\");\n+  const [saving, setSaving] = useState(false);\n+  // one key per form: a second press of Save sends the same key, and the\n+  // API answers with the ticket it already created\n+  const dedupKey = useMemo(() => crypto.randomUUID(), []);\n \n   async function save() {\n-    const ticket = await createTicket({ title, body });\n-    onSaved(ticket);\n+    if (saving) return;\n+    setSaving(true);\n+    try {\n+      const ticket = await createTicket({ title, body, dedupKey });\n+      onSaved(ticket);\n+    } finally {\n+      setSaving(false);\n+    }\n   }\n \n   return (\n     <form onSubmit={(e) => { e.preventDefault(); save(); }}>\n       <Field label=\"Title\" value={title} onChange={setTitle} />\n       <Field label=\"Description\" value={body} onChange={setBody} multiline />\n       <div className=\"row\">\n         <Button onClick={onCancel}>Cancel</Button>\n-        <Button primary type=\"submit\">Save</Button>\n+        <Button primary type=\"submit\" disabled={saving}>\n+          {saving ? <><Spinner /> Saving…</> : \"Save\"}\n+        </Button>\n       </div>\n     </form>\n   );\n"
      },
      {
        "path": "web/src/api.ts",
        "status": "modified",
        "diff": "@@ -10,12 +10,19 @@ export type NewTicket = {\n   title: string;\n   body: string;\n+  dedupKey: string;\n };\n \n export async function createTicket(ticket: NewTicket): Promise<Ticket> {\n-  const res = await fetch(\"/api/tickets\", { method: \"POST\", body: JSON.stringify(ticket) });\n-  if (!res.ok) throw new ApiError(res.status);\n-  return res.json();\n+  const res = await fetch(\"/api/tickets\", {\n+    method: \"POST\",\n+    headers: { \"Idempotency-Key\": ticket.dedupKey },\n+    body: JSON.stringify({ title: ticket.title, body: ticket.body }),\n+  });\n+  // 409: the same key created a ticket already; the body is that ticket\n+  if (!res.ok && res.status !== 409) throw new ApiError(res.status);\n+  return res.json();\n }\n"
      },
      {
        "path": "lib/helpdesk_web/controllers/ticket_controller.ex",
        "status": "modified",
        "diff": "@@ -14,9 +14,14 @@ defmodule HelpdeskWeb.TicketController do\n-  def create(conn, params) do\n-    with {:ok, ticket} <- Tickets.create(params) do\n-      conn |> put_status(:created) |> json(ticket)\n+  def create(conn, params) do\n+    key = conn |> get_req_header(\"idempotency-key\") |> List.first()\n+\n+    case Tickets.create(params, key) do\n+      {:ok, ticket} -> conn |> put_status(:created) |> json(ticket)\n+      {:duplicate, ticket} -> conn |> put_status(:conflict) |> json(ticket)\n+      {:error, changeset} -> conn |> put_status(:unprocessable_entity) |> json(errors(changeset))\n     end\n   end\n"
      },
      {
        "path": "lib/helpdesk/tickets.ex",
        "status": "modified",
        "diff": "@@ -71,18 +71,34 @@ defmodule Helpdesk.Tickets do\n   @doc \"\"\"\n   Creates a ticket from the form's fields.\n+\n+  A second call with the same dedup key within ten seconds returns the\n+  ticket the first call created, as `{:duplicate, ticket}`.\n   \"\"\"\n-  def create(attrs) do\n-    %Ticket{}\n-    |> Ticket.changeset(attrs)\n-    |> Repo.insert()\n-    |> notify()\n+  def create(attrs, dedup_key) do\n+    case recent_with_key(dedup_key) do\n+      %Ticket{} = ticket ->\n+        {:duplicate, ticket}\n+\n+      nil ->\n+        %Ticket{dedup_key: dedup_key}\n+        |> Ticket.changeset(attrs)\n+        |> Repo.insert()\n+        |> notify()\n+    end\n+  end\n+\n+  defp recent_with_key(key) do\n+    since = DateTime.add(DateTime.utc_now(), -10, :second)\n+    Repo.one(from t in Ticket, where: t.dedup_key == ^key and t.inserted_at > ^since)\n   end\n"
      },
      {
        "path": "priv/repo/migrations/20261019_add_dedup_key_to_tickets.exs",
        "status": "added",
        "diff": "@@ -0,0 +1,10 @@\n+defmodule Helpdesk.Repo.Migrations.AddDedupKeyToTickets do\n+  use Ecto.Migration\n+\n+  def change do\n+    alter table(:tickets) do\n+      add :dedup_key, :string\n+    end\n+\n+    create index(:tickets, [:dedup_key, :inserted_at])\n+  end\n+end\n"
      },
      {
        "path": "test/helpdesk/tickets_test.exs",
        "status": "modified",
        "diff": "@@ -40,6 +40,19 @@ defmodule Helpdesk.TicketsTest do\n+  test \"a second create with the same key returns the first ticket\" do\n+    {:ok, first} = Tickets.create(@valid, \"k-1\")\n+    assert {:duplicate, ^first} = Tickets.create(@valid, \"k-1\")\n+  end\n+\n+  test \"the same key ten seconds later creates a new ticket\" do\n+    {:ok, first} = Tickets.create(@valid, \"k-2\")\n+    backdate(first, 11)\n+    assert {:ok, second} = Tickets.create(@valid, \"k-2\")\n+    refute second.id == first.id\n+  end\n+\n"
      },
      {
